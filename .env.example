PORT=8086
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:1.5b

# Timeouts (milliseconds)
# Ollama chat: large local models may need several minutes on modest hardware
OLLAMA_CHAT_TIMEOUT_MS=600000
# Cloud providers (Groq, OpenAI, Gemini)
CLOUD_CHAT_TIMEOUT_MS=120000

# External providers — only non-empty keys appear in Settings
GROQ_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
